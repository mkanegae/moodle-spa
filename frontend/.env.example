# Notion API Configuration
# Get your Notion integration token from: https://www.notion.so/my-integrations
REACT_APP_NOTION_TOKEN=your_notion_integration_token_here
REACT_APP_NOTION_API_URL=https://api.notion.com/v1
REACT_APP_NOTION_VERSION=2022-06-28

# Development Environment
NODE_ENV=development
GENERATE_SOURCEMAP=true
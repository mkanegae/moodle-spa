# BFF Server Environment Variables

# Server
NODE_ENV=production
BFF_PORT=4000

# Moodle
MOODLE_URL=http://ec2-xx-xx-xx-xx.compute-1.amazonaws.com

# AI API
AI_API_URL=http://ec2-yy-yy-yy-yy.compute-1.amazonaws.com:8001

# Session
SESSION_SECRET=your-random-session-secret-min-32-chars
SESSION_TABLE=moodle-bff-sessions

# AWS
AWS_REGION=us-east-1

# CORS
ALLOWED_ORIGINS=https://d123456abcdef.cloudfront.net,https://yourdomain.com
